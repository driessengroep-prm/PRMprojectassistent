      "name": "Verzoek binnen",
      "webhookId": "c4d2e8a1-7b36-4f52-9e18-3a7c5d2b9f40"
    },
    {
      "parameters": {
        "url": "https://graph.microsoft.com/v1.0/me?$select=id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.headers.authorization }}"
