      "id": "e1000000-0000-4000-8000-000000000003",
      "name": "Wie ben jij",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// De oid komt uit het antwoord van Microsoft, het sessie_id uit het\n// verzoek. Beide gaan straks als filter mee; samen zorgen ze ervoor dat\n// je alleen je eigen gesprek kunt wissen.\nconst wie = $input.first().json;\nconst verzoek = $('Verzoek binnen').first().json;\nconst sessieId = verzoek.body?.sessieId ?? verzoek.sessieId ?? '';\n\nif (!wie.id) { throw new Error('geen identiteit uit het token'); }\nif (!sessieId) { throw new Error('geen sessieId meegestuurd'); }\n\nreturn [{ json: { entra_oid: wie.id, sessie_id: sessieId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
